    "tiles": [
      {
        "height": 16,
        "widget": {
          "title": "Output Tokens por Vers\u00e3o",
          "xyChart": {
            "chartOptions": {
              "mode": "COLOR"
            },
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "targetAxis": "Y1",
                "timeSeriesQuery": {
                  "timeSeriesFilter": {
                    "aggregation": {
                      "alignmentPeriod": "3600s",
                      "groupByFields": [
                        "metric.label.cc_version",
                        "metric.label.prompt_id"
                      ],
                      "perSeriesAligner": "ALIGN_MEAN"
                    },
                    "filter": "metric.type=\"custom.googleapis.com/cc_benchmark_output_tokens\""
                  }
                }
              }
            ],
            "yAxis": {
              "label": "tokens",
              "scale": "LINEAR"
            }
          }
        },
        "width": 24
      },
